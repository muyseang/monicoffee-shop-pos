<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows a system launch screen before the app draws. Make it the dark
         background of the design's splash (01) with no icon, so it runs straight into
         SplashScreen instead of flashing the default robot icon on white. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#007D57</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:statusBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#FFFFFF</item>
        <item name="android:windowSplashScreenBackground">#1F1F1F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
